# platform_health.py 用配置模板。复制为 .env 并按需填写：cp .env.example .env
# 脚本会自动读取同目录的 .env，直接运行即可：
#   sudo python3 platform_health.py --show-payload
# （命令行/环境变量传入的值仍优先覆盖 .env）

# --- 网页探活（已确认可用的健康端点，均返回 200）---
SENTRY_URL=https://sentry.randd-nn-freebit.net/_health/
POSTHOG_URL=https://posthog.randd-nn-freebit.net/_health
# 说明：用深度健康端点 /_health（会验 DB/缓存等依赖），比首页或 /_livez 更能发现问题。
#      PostHog /_health 正常约 1.8s，突然变慢会触发「响应过慢」提示。
# 如需一次配多个： WEB_TARGETS=Sentry=https://.../_health/ , PostHog=https://.../_health
WEB_LATENCY_WARN_MS=5000   # 健康端点响应超过此毫秒数 → WARN
# 自建证书不受信任时临时： WEB_INSECURE=1

# --- 关注的核心容器名前缀（匹配到即标 ★）---
WATCH_PREFIXES=sentry,posthog,clickhouse,kafka,redis,postgres,snuba
# 完全排除判定的容器（名称包含即匹配，逗号分隔），用于已知的一次性任务容器
IGNORE_CONTAINERS=

# --- 关注提示的阈值 ---
# ★这些不是告警通道（实时告警归 slack_alert.sh）；仅用于给 AI 提示和算总合状态。
#  数值刻意对齐 slack_alert.sh，改动时请两边一起改，保持单一心智模型。
DISK_WARN=85              # 磁盘使用率 % ≥ 此值 → WARN（同 Slack DISK_WARN_PCT）
DISK_CRIT=95              # 磁盘使用率 % ≥ 此值 → CRIT（同 Slack DISK_CRIT_PCT）
MEM_AVAIL_WARN_GB=2       # 可用内存 ≤ N GB → WARN（同 Slack RAM_WARN_GB）
MEM_AVAIL_CRIT_GB=1       # 可用内存 ≤ N GB → CRIT（同 Slack RAM_CRIT_GB）
SWAP_WARN_GB=5           # swap 已用 ≥ N GB → WARN（同 Slack SWAP_WARN_GB）
SWAP_CRIT_GB=10          # swap 已用 ≥ N GB → CRIT（同 Slack SWAP_CRIT_GB）
LOAD_PER_CPU_WARN=1.5    # 每核 load ≥ 此值 → WARN
RECENT_RESTART_DAYS=1    # 容器 uptime < N 天视为「最近重启过」→ INFO

# --- AI 诊断（对应 provider 的 key 留空则仅出规则提示，等同 --dry-run）---
AI_PROVIDER=gemini        # gemini / anthropic
GEMINI_API_KEY=           # https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-pro
ANTHROPIC_API_KEY=        # Anthropic Console 发行，按 token 单独计费
ANTHROPIC_MODEL=claude-sonnet-5-5

REPORT_LANG=ja           # ja / zh / en

# --- 产物 ---
OUT_DIR=
KEEP_DAYS=14