# platform_health.py の設定テンプレート。.env にコピーして必要に応じて記入する：cp .env.example .env
# スクリプトは同じディレクトリの .env を自動で読み込むので、そのまま実行できる：
#   sudo python3 platform_health.py --show-payload
# （コマンドライン / 環境変数で渡した値が .env より優先される）

# --- Web 疎通（確認済みのヘルス端点。いずれも 200 を返す）---
SENTRY_URL=https://sentry.randd-nn-freebit.net/_health/
POSTHOG_URL=https://posthog.randd-nn-freebit.net/_health
# 説明：深いヘルスチェック /_health（DB やキャッシュ等の依存先まで検査）を使う。トップページや /_livez より問題を見つけやすい。
#      EC2 上の実測は両方とも約 150ms（2026-10）。急に遅くなると「応答が遅い」として検出される。
# 複数指定する場合： WEB_TARGETS=Sentry=https://.../_health/ , PostHog=https://.../_health
WEB_LATENCY_WARN_MS=5000   # ヘルス端点の応答がこのミリ秒を超えたら → WARN
# 自己署名証明書が信頼されない場合（一時的に）： WEB_INSECURE=1

# --- コアコンテナ（名前に含まれていれば一致、★ を付ける）---
# sentry / posthog のように全コンテナが含む語は書かないこと（★ の意味がなくなる）
WATCH_PREFIXES=-web-,-nginx-,-relay-,-postgres-,-db-,-pgbouncer-,-kafka-,-clickhouse-,-redis,-snuba-api-,-taskworker-,-capture-,-ingestion-
# 判定から完全に除外するコンテナ（名前に含まれていれば一致、カンマ区切り）。既知の一回限りのタスク用
IGNORE_CONTAINERS=

# --- 注目ポイントの閾値 ---
# ★リアルタイム通知ではない（リアルタイム通知は slack_alert.sh の担当）。AI への注目ポイントと総合ステータスの算出にだけ使う。
#  数値は slack_alert.sh と意図的に揃えている。変更するときは両方を直すこと。
DISK_WARN=85              # ディスク使用率 % ≥ この値 → WARN（Slack の DISK_WARN_PCT と同じ）
DISK_CRIT=95              # ディスク使用率 % ≥ この値 → CRIT（Slack の DISK_CRIT_PCT と同じ）
MEM_AVAIL_WARN_GB=2       # 空きメモリ < N GiB → WARN（Slack の RAM_WARN_GB と同じ）
MEM_AVAIL_CRIT_GB=1       # 空きメモリ < N GiB → CRIT（Slack の RAM_CRIT_GB と同じ）
SWAP_WARN_GB=8            # swap 使用量 ≥ N GiB → WARN（Slack の SWAP_WARN_GB と同じ）
SWAP_CRIT_GB=10           # swap 使用量 ≥ N GiB → CRIT（Slack の SWAP_CRIT_GB と同じ）
LOAD_PER_CPU_WARN=1.5     # コアあたり load ≥ この値 → WARN
RECENT_RESTART_DAYS=1     # 増分データがないとき（初回 / コンテナ再作成）、uptime < N 日を「最近再起動」とみなす → INFO

# --- 傾向・活動（本スクリプト独自。前回巡検の out/state.json と比較）---
RESTART_DELTA_CRIT=3      # 前回巡検以降の再起動 ≥ N → CRIT（クラッシュの繰り返しの疑い）。≥1 → WARN
SWAP_IO_WARN_KBPS=1024    # 前回巡検以降の swap 換入+換出の平均 ≥ N KB/s → WARN（実際のメモリ逼迫）
TOP_MEM_N=8               # AI に渡すメモリ / swap 使用量上位 N コンテナ
DISK_TREND_DAYS=14        # ディスク増加速度は直近 N 日のサンプルで線形回帰
DISK_FORECAST_WARN_DAYS=30  # N 日以内に DISK_WARN 到達見込み → WARN

# --- slack_alert.sh と揃えたコンテナのメモリ閾値（名前:GiB）。変更するときは両方を直す ---
CONTAINER_MEM_BUDGETS=posthog-web-1:5,posthog-clickhouse-1:2,sentry-self-hosted-web-1:1.5,sentry-self-hosted-snuba-api-1:2
BUDGET_INFO_PCT=80        # 閾値の N% 以上 → INFO

# --- nginx 5xx の集計（前回巡検以降、最長 24h）---
NGINX_CONTAINERS=sentry-self-hosted-nginx-1
NGINX_5XX_WARN_PCT=1      # 5xx 比率 ≥ N% かつ
NGINX_5XX_WARN_MIN=20     # 件数 ≥ N → WARN

# --- Slack 通知（状態が変わったときだけ送る。空 = 送らない）。slack_alert.sh と同じ Webhook で可。git には絶対にコミットしないこと ---
SLACK_WEBHOOK_URL=

# --- CloudWatch（aws CLI 経由。インスタンスロールに iam/cloudwatch-read-policy.json の権限が必要）---
CLOUDWATCH=1              # 0 = CloudWatch を参照しない
CW_INSTANCE_ID=           # 空なら IMDS から自動取得
AWS_REGION=               # 空なら IMDS から自動取得
CW_CPU_WARN=80            # 直近 1h の CPU 平均 % ≥ → WARN
CW_BALANCE_WARN=20        # EBS IO / スループットのバースト残高 % ≤ → WARN（枯渇すると制限される）
CW_CPU_CREDIT_WARN=10     # T 系の CPU クレジット残高 ≤ → WARN

# --- AI 診断（使う provider のキーが空ならルール判定のみ。--dry-run と同じ）---
AI_PROVIDER=gemini        # gemini / anthropic
GEMINI_API_KEY=           # https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini-2.5-flash   # 主モデルが再試行後も失敗したときに使う
ANTHROPIC_API_KEY=        # Anthropic Console で発行（別途従量課金）
ANTHROPIC_MODEL=claude-sonnet-5-5

REPORT_LANG=ja            # AI 診断の言語 ja / zh / en

# --- 成果物 ---
OUT_DIR=
KEEP_DAYS=14
