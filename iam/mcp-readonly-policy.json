{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "McpCloudWatchRead",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*"
    },
    {
      "Sid": "McpNeverShell",
      "Effect": "Deny",
      "Action": [
        "ssm:StartSession",
        "ssm:ResumeSession",
        "ec2-instance-connect:SendSSHPublicKey",
        "ec2:ModifyInstanceAttribute",
        "iam:*"
      ],
      "Resource": "*"
    }
  ]
}
